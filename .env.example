# Public mobile app config. Values prefixed with EXPO_PUBLIC_ are bundled into the app.
# Do not put API keys or secrets in EXPO_PUBLIC_* values.
EXPO_PUBLIC_PROXY_URL=https://dininglens-api.onrender.com

# Backend-only secrets. Set these on the hosted server, not in the mobile app bundle.
ANTHROPIC_API_KEY=
USDA_API_KEY=
GOOGLE_PLACES_API_KEY=

# Backend deployment/security config.
NODE_ENV=production
PORT=3001
CORS_ORIGINS=
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AI=40
RATE_LIMIT_SCRAPE=12

