# Public mobile app config. Values prefixed with EXPO_PUBLIC_ are bundled into the app.
# Do not put API keys or secrets in EXPO_PUBLIC_* values.
EXPO_PUBLIC_PROXY_URL=https://dininglens-api.onrender.com

# Backend-only secrets. Set these on the hosted server, not in the mobile app bundle.
ANTHROPIC_API_KEY=
USDA_API_KEY=
GOOGLE_PLACES_API_KEY=

# Backend deployment/security config.
NODE_ENV=production
PORT=3001
CORS_ORIGINS=
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AI=40
RATE_LIMIT_SCRAPE=12
RATE_LIMIT_DETECT_RESTAURANT=20
RATE_LIMIT_LOOKUP=60
RATE_LIMIT_BARCODE=60

# Entitlement and scrape tuning (optional; defaults shown).
TRIAL_DAYS=14
TRIAL_COACH_DAILY_LIMIT=3
PAID_COACH_DAILY_LIMIT=20
TRIAL_SCRAPE_DAILY_LIMIT=5
PAID_SCRAPE_DAILY_LIMIT=30
SCRAPE_MENU_ENABLED=true
SCRAPE_CACHE_TTL_HOURS=12

